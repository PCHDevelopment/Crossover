DATABASE_URL=postgres://crossover:crossover@localhost:5432/crossover
REDIS_URL=redis://localhost:6379
WORKSPACE_ROOT=./.data/workspaces
# Docker Compose server runtime: use the same absolute host/container path so Docker can mount
# canonical repositories into sandbox containers.
CROSSOVER_WORKSPACE_ROOT=${PWD}/.data/workspaces
# Numeric group ID of /var/run/docker.sock (Linux: stat -c '%g' /var/run/docker.sock).
DOCKER_GID=998
# Comma-separated allowlist for room health_image settings; default: node:22-bookworm-slim
HEALTH_IMAGES=node:22-bookworm-slim
# GitHub OAuth App callback: <OAUTH_PUBLIC_BASE_URL>/v1/auth/oauth/github/callback (HTTPS; localhost dev only).
# OAUTH_PUBLIC_BASE_URL=https://crossover.example.com
# GITHUB_OAUTH_CLIENT_ID=<OAuth App client ID>
# GITHUB_OAUTH_CLIENT_SECRET=<OAuth App client secret>
# Google OAuth callback: <OAUTH_PUBLIC_BASE_URL>/v1/auth/oauth/google/callback.
# GOOGLE_OAUTH_CLIENT_ID=<Google OAuth client ID>
# GOOGLE_OAUTH_CLIENT_SECRET=<Google OAuth client secret>
# DEV_LOGIN=false (opt-in; production also requires the explicit override below)
# DEV_LOGIN_ALLOW_PRODUCTION=false

# Sandbox disk quotas default to soft outside production and hard in production.
# Hard mode needs a quota-capable Docker volume driver and its options as a JSON object.
# SANDBOX_DISK_ENFORCEMENT=hard
# SANDBOX_VOLUME_DRIVER=local
# SANDBOX_VOLUME_OPTS={"type":"none","device":"/srv/sandbox","o":"bind,pquota"}
# Optional isolation runtime; configure `runsc` when Docker gVisor is installed.
# SANDBOX_RUNTIME=runsc
# Optional platform egress proxy container. Sandboxes use per-sandbox internal Docker networks.
# SANDBOX_EGRESS_PROXY_CONTAINER=crossover-egress-proxy
# SANDBOX_EGRESS_PROXY_PORT=3128
# Generate once and configure the same 32+ byte secret on the server and proxy process.
# The server uses it for sandbox credentials and short-lived health-install credentials.
# SANDBOX_EGRESS_PROXY_SECRET=<openssl rand -base64 32>
# The proxy process also needs DATABASE_URL and listens on EGRESS_PROXY_HOST/EGRESS_PROXY_PORT.

# Integration secret encryption: use the development key locally, KMS in production.
# Generate the development key with `openssl rand -hex 32`.
# INTEGRATION_SECRET_KEY=<64 hex characters>
# INTEGRATION_KMS_KEY_ID=<AWS KMS key id or ARN>
# Optional GitHub App connection and credential broker. Store the PEM with literal `\n` newlines
# or actual newlines; the server normalizes literal escapes.
# GITHUB_APP_ID=<numeric App ID>
# GITHUB_APP_SLUG=<GitHub App slug>
# GITHUB_CLIENT_ID=<App client ID>
# GITHUB_CLIENT_SECRET=<App client secret>
# GITHUB_APP_PRIVATE_KEY=<PEM private key>
# Build and publish the isolated first-party GitHub worker, then configure its immutable registry digest.
# docker build -f plugins/github/Dockerfile -t <registry>/crossover-github-plugin:<version> .
# GITHUB_PLUGIN_IMAGE=<registry>/crossover-github-plugin@sha256:<64 lowercase hex characters>
# BROWSER_PLUGIN_IMAGE=<registry>/crossover-browser-plugin@sha256:<64 lowercase hex characters>

# Refresh and OAuth-start routes: attempts per client address per minute (default 30), and whether
# the address comes from X-Forwarded-For (set only behind a reverse proxy you control).
# REFRESH_PER_MINUTE=30
# TRUST_PROXY=10.0.0.0/8  # comma-separated reverse proxies (addresses or CIDRs) in front of the server; the client address is the first X-Forwarded-For hop that is not one of them
# Serve the built web app next to the API (build it with `pnpm --filter @crossover/web build`):
# WEB_ROOT=apps/web/dist/app
# Internal sandbox Git listener. Attach the server container to GIT_INTERNAL_NETWORK before startup,
# then set GIT_INTERNAL_HOST to that private-network IP or the container name; names resolve to the
# container's configured private-network address at startup (never bind this listener to a wildcard).
# Never publish GIT_INTERNAL_PORT. The server container name lets one-shot fetchers attach there.
# Docker must see WORKSPACE_ROOT and each repo_path at the same source paths for reference mounts.
# Build the image with:
# docker build -f apps/git-fetcher/Dockerfile -t crossover-git-fetcher:latest .
# GIT_INTERNAL_HOST=172.30.0.2
# GIT_INTERNAL_NETWORK=crossover-git
# GIT_INTERNAL_PORT=8081
# GIT_INTERNAL_CONTAINER=crossover-server
# GIT_INTERNAL_TOKEN_SECRET=<openssl rand -hex 32>
# GIT_FETCHER_IMAGE=crossover-git-fetcher:latest

# Wake-up webhooks (ARCHITECTURE 17.4): the key each agent's webhook secret is derived from.
# Without it agents with a wake_webhook_url are not called. Keep it secret; changing it changes every secret.
# WAKE_WEBHOOK_KEY=<openssl rand -base64 32>
