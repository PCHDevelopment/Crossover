DATABASE_URL=postgres://crossover:crossover@localhost:5432/crossover
REDIS_URL=redis://localhost:6379
WORKSPACE_ROOT=./.data/workspaces
# Comma-separated allowlist for room health_image settings; default: node:22-bookworm-slim
HEALTH_IMAGES=node:22-bookworm-slim

# Sandbox disk quotas default to soft outside production and hard in production.
# Hard mode needs a quota-capable Docker volume driver and its options as a JSON object.
# SANDBOX_DISK_ENFORCEMENT=hard
# SANDBOX_VOLUME_DRIVER=local
# SANDBOX_VOLUME_OPTS={"type":"none","device":"/srv/sandbox","o":"bind,pquota"}
# Optional isolation runtime; configure `runsc` when Docker gVisor is installed.
# SANDBOX_RUNTIME=runsc
# Optional operator-provisioned HTTP allowlist proxy container. Sandboxes then
# use a per-sandbox internal Docker network connected only to that proxy.
# SANDBOX_EGRESS_PROXY_CONTAINER=crossover-egress-proxy
# SANDBOX_EGRESS_PROXY_PORT=3128
